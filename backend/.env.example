# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

APP_ENV=development
APP_DEBUG=true
# Swagger en /docs. Si no se define: activo salvo con APP_ENV=production.
# DOCS_ENABLED=true

# Opción A — MySQL local (docker-compose levanta uno en localhost:3306)
DATABASE_URL=mysql+pymysql://cyberwhatif:cyberwhatif@localhost:3306/cyberwhatif
DATABASE_SSL=false

# Opción B — Azure Database for MySQL (Flexible Server). Exige TLS: DATABASE_SSL=true.
# Los caracteres especiales de la contraseña van codificados para URL (ej. # -> %23, + -> %2B).
# DATABASE_URL=mysql+pymysql://usuario:contrasena-codificada@mi-servidor.mysql.database.azure.com:3306/cyberwhatif
# DATABASE_SSL=true

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Número de WhatsApp al que se redirige tras contratar un plan (RF-10), formato internacional sin '+'
WHATSAPP_NUMBER=573000000000

# Generador de empresas simuladas: "fake" (determinista, sin costo) o "llm" (pendiente de implementar)
COMPANY_GENERATOR=fake
