# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

APP_ENV=development
APP_DEBUG=true

# MySQL / MariaDB (docker-compose levanta uno en localhost:3306)
DATABASE_URL=mysql+pymysql://cyberwhatif:cyberwhatif@localhost:3306/cyberwhatif

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Número de WhatsApp al que se redirige tras contratar un plan (RF-10), formato internacional sin '+'
WHATSAPP_NUMBER=573000000000

# Generador de empresas simuladas: "fake" (determinista, sin costo) o "llm" (pendiente de implementar)
COMPANY_GENERATOR=fake
